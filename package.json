{
  "name": "dcr-js",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://hugoalopez-dtu.github.io/dcr-js/",
  "scripts": {
    "start": "npm run -w app start",
    "predeploy": "npm run -w app predeploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p dcr-engine && npm exec -w app -- tsc -b",
    "lint": "npm run -w app lint"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "workspaces": [
    "modeler",
    "app",
    "dcr-engine"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "prettier": "3.6.2",
    "quickpickle": "^1.11.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
